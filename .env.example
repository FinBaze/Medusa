# Public Medusa backend URL used for OAuth redirect.
MEDUSA_BACKEND_URL=http://localhost:9000

# Logical store key for multi-store Medusa apps.
FINBAZE_STORE_KEY=default

# Optional — only for hosted installs that use client_credentials token refresh.
# Public/OSS installs use PKCE only; leave unset.
# FINBAZE_APP_CLIENT_SECRET=

# Optional overrides — unset uses production defaults
# (https://api.platform.finbaze.com, https://platform.finbaze.com, finbaze-medusa).
# FINBAZE_API_URL=http://localhost:3000
# FINBAZE_WEB_BASE_URL=http://localhost:3001
# FINBAZE_APP_CLIENT_ID=finbaze-medusa
